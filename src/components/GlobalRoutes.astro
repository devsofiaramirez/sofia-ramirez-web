---
// Animación de marca: rutas de vuelo cruzando un globo abstracto (China ⇄ Colombia + rutas secundarias).
// SVG + SMIL (<animateMotion>), sin JS ni librerías — barato en CPU/INP y se repite indefinidamente.
const routes = [
  { id: 'route-main', d: 'M 730,120 C 800,-40 330,-40 460,255', color: 'var(--color-gold-light)', dur: '9s', begin: '0s' },
  { id: 'route-b', d: 'M 460,255 C 380,340 250,300 190,190', color: 'var(--color-teal)', dur: '7s', begin: '-2.4s' },
  { id: 'route-c', d: 'M 730,120 C 850,90 980,150 1020,220', color: 'var(--color-sky)', dur: '8s', begin: '-4.8s' },
];

const cities = [
  { x: 730, y: 120, label: 'China' },
  { x: 460, y: 255, label: 'Cúcuta, Colombia' },
  { x: 190, y: 190, label: '' },
  { x: 1020, y: 220, label: '' },
];
---

<section class="relative overflow-hidden border-y border-[var(--color-border)] bg-[var(--color-bg-elevated)]/40 py-16 md:py-24">
  <div class="container relative z-10 mb-10 max-w-2xl" data-reveal>
    <p class="mb-3 text-xs font-semibold uppercase tracking-[0.3em] text-[var(--color-teal)]">Alcance global</p>
    <h2 class="h2-display font-bold">Presencia real entre China y Colombia</h2>
    <p class="mt-4 text-[var(--color-text-muted)]">
      Rutas aéreas activas, bodega propia en Cúcuta y una red de contactos en origen para que tu carga se mueva sin sorpresas.
    </p>
  </div>

  <div class="relative mx-auto aspect-[3/1] w-full max-w-6xl px-4" data-reveal aria-hidden="true">
    <svg viewBox="0 0 1200 400" class="h-full w-full overflow-visible" role="presentation">
      <defs>
        <radialGradient id="globe-fill" cx="50%" cy="45%" r="60%">
          <stop offset="0%" stop-color="var(--color-teal)" stop-opacity="0.12" />
          <stop offset="100%" stop-color="var(--color-teal)" stop-opacity="0" />
        </radialGradient>
      </defs>

      <!-- Globo abstracto (wireframe) -->
      <g stroke="var(--color-border-teal)" stroke-width="1.5" fill="none">
        <circle cx="600" cy="200" r="170" fill="url(#globe-fill)" />
        <ellipse cx="600" cy="200" rx="170" ry="60" />
        <ellipse cx="600" cy="150" rx="145" ry="30" />
        <ellipse cx="600" cy="250" rx="145" ry="30" />
        <ellipse cx="600" cy="200" rx="60" ry="170" />
      </g>

      <!-- Rutas de vuelo -->
      {routes.map((r) => (
        <path id={r.id} d={r.d} fill="none" stroke={r.color} stroke-width="1.5" stroke-dasharray="5 7" opacity="0.55" />
      ))}

      <!-- Ciudades: punto + pulso de radar -->
      {cities.map((c) => (
        <g>
          <circle cx={c.x} cy={c.y} r="4" fill="var(--color-gold-light)" />
          <circle cx={c.x} cy={c.y} r="4" fill="none" stroke="var(--color-gold-light)" stroke-width="1.5">
            <animate attributeName="r" values="4;16;4" dur="2.8s" repeatCount="indefinite" />
            <animate attributeName="opacity" values="0.6;0;0.6" dur="2.8s" repeatCount="indefinite" />
          </circle>
          {c.label && (
            <text
              x={c.x}
              y={c.y - 16}
              text-anchor="middle"
              class="fill-[var(--color-text)]"
              style="font-family: var(--font-body); font-size: 15px; font-weight: 600;"
            >
              {c.label}
            </text>
          )}
        </g>
      ))}

      <!-- Aviones viajando por cada ruta -->
      {routes.map((r) => (
        <path d="M -7,-3.5 L 7,0 L -7,3.5 L -3.5,0 Z" fill={r.color}>
          <animateMotion dur={r.dur} begin={r.begin} repeatCount="indefinite" rotate="auto">
            <mpath href={`#${r.id}`} />
          </animateMotion>
        </path>
      ))}
    </svg>
  </div>
</section>
