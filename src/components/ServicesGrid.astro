---
import type { Service } from '@/lib/db';
import PlaceholderImage from '@/components/PlaceholderImage.astro';
import { CATEGORIES, categoryMeta } from '@/lib/categories';

interface Props {
  services: Service[];
  /** Título y texto de la sección (en las páginas propias ya los pone el PageHero). */
  showHeading?: boolean;
  /** Botones de filtro por categoría. */
  showFilters?: boolean;
  /** Enlace "Ver todos" debajo de la rejilla (en el inicio). */
  moreLink?: { href: string; label: string };
  emptyText?: string;
}
const { services, showHeading = true, showFilters = true, moreLink, emptyText = 'Pronto habrá servicios en esta categoría.' } = Astro.props;

// Solo se muestran los filtros de categorías que tengan al menos un servicio activo.
const present = (Object.keys(CATEGORIES) as (keyof typeof CATEGORIES)[]).filter((c) => services.some((s) => s.category === c));
const filters = [{ key: 'todos', label: 'Todos' }, ...present.map((c) => ({ key: c, label: CATEGORIES[c].filter }))];
---

<section id="servicios" class="section-padding relative bg-[var(--color-bg-elevated)]/60">
  <div class="container">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      {showHeading && (
        <div class="max-w-2xl" data-reveal>
          <p class="eyebrow">Portafolio</p>
          <h2 class="h2-display font-extrabold">Servicios y <span class="highlight">cursos</span></h2>
          <p class="mt-4 text-[var(--color-text-muted)]">Elige cómo quieres que te acompañemos: que lo hagamos por ti, que te enseñemos o que movamos tu carga.</p>
        </div>
      )}

      {showFilters && filters.length > 2 && (
        <div class="filter-tabs inline-flex w-fit max-w-full overflow-x-auto rounded-full border border-[var(--color-border)] bg-white p-1.5 shadow-sm" role="group" aria-label="Filtrar servicios" data-reveal>
          <span class="filter-indicator" aria-hidden="true"></span>
          {filters.map((f, i) => (
            <button type="button" class="filter-tab whitespace-nowrap rounded-full px-4 py-2 text-sm font-semibold text-[var(--color-text-muted)]" data-filter={f.key} aria-pressed={i === 0 ? 'true' : 'false'}>
              {f.label}
            </button>
          ))}
        </div>
      )}
    </div>

    <div class="services-grid mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((service, i) => {
        const meta = categoryMeta(service.category);
        return (
          <article class="service-card card-soft spotlight group relative flex flex-col overflow-hidden" data-category={service.category} data-reveal style={`--reveal-delay:${(i % 3) * 100}ms`}>
            <div class="img-zoom relative m-3 mb-0 overflow-hidden rounded-[0.9rem]">
              {service.image_url ? (
                <img
                  src={service.image_url}
                  alt=""
                  width="480"
                  height="600"
                  loading="lazy"
                  decoding="async"
                  class="aspect-[4/5] w-full object-cover object-[center_15%]"
                  transition:name={`servicio-${service.slug}`}
                />
              ) : (
                <PlaceholderImage label={`Foto: ${service.title}`} aspect="4/5" />
              )}
              <span class="absolute left-3 top-3 flex items-center gap-1.5 rounded-full bg-white/90 px-3 py-1.5 text-[0.68rem] font-bold uppercase tracking-wider text-[var(--color-brand)] shadow-sm backdrop-blur">
                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={meta.icon} />
                {meta.label}
              </span>
              {service.video_url && (
                <span class="absolute right-3 top-3 flex items-center gap-1 rounded-full bg-[var(--color-ink)]/75 px-2.5 py-1.5 text-xs font-semibold text-white">
                  <svg class="h-3 w-3" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 4l14 8-14 8z"/></svg> Video
                </span>
              )}
            </div>

            <div class="relative z-[2] flex flex-1 flex-col p-6 pt-5">
              <h3 class="text-xl font-bold leading-snug">
                <!-- El enlace cubre toda la tarjeta (::after) para que se pueda tocar en cualquier parte. -->
                <a href={`/servicios/${service.slug}`} class="after:absolute after:inset-0 after:z-[3] after:content-['']">{service.title}</a>
              </h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-[var(--color-text-muted)]">{service.description}</p>

              <div class="mt-6 flex items-center justify-between gap-3">
                <span class="inline-flex items-center gap-2 text-sm font-bold text-[var(--color-brand)]">
                  Ver detalle
                  <svg class="btn-arrow h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </span>
                {service.cta_url && (
                  <a href={service.cta_url} target="_blank" rel="noopener" class="btn-accent relative z-[4] !px-4 !py-2 text-sm">
                    {service.cta_text}
                  </a>
                )}
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <p class:list={['services-empty mt-8 text-center text-[var(--color-text-muted)]', { hidden: services.length > 0 }]}>{emptyText}</p>

    {moreLink && (
      <div class="mt-12 flex justify-center" data-reveal>
        <a href={moreLink.href} class="btn-dark">
          {moreLink.label}
          <svg class="btn-arrow h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
    )}
  </div>
</section>

<script>
  import { onPageLoad } from '@/scripts/motion';

  onPageLoad(() => {
    const section = document.getElementById('servicios');
    const tabs = [...(section?.querySelectorAll<HTMLButtonElement>('.filter-tab') ?? [])];
    if (!section || !tabs.length) return;
    const indicator = section.querySelector<HTMLElement>('.filter-indicator')!;
    const cards = [...section.querySelectorAll<HTMLElement>('.service-card')];
    const empty = section.querySelector<HTMLElement>('.services-empty')!;

    const moveIndicator = (tab: HTMLElement) => {
      indicator.style.width = `${tab.offsetWidth}px`;
      indicator.style.transform = `translateX(${tab.offsetLeft}px)`;
    };

    const apply = (key: string) => {
      const tab = tabs.find((t) => t.dataset.filter === key) ?? tabs[0];
      tabs.forEach((t) => t.setAttribute('aria-pressed', String(t === tab)));
      moveIndicator(tab);
      // Primero se desvanecen las que salen; luego se ocultan para que la rejilla se reacomode.
      let visible = 0;
      cards.forEach((c) => {
        const show = tab.dataset.filter === 'todos' || c.dataset.category === tab.dataset.filter;
        if (show) {
          visible++;
          c.hidden = false;
          c.classList.add('is-visible');
          requestAnimationFrame(() => (c.dataset.filteredOut = 'false'));
        } else {
          c.dataset.filteredOut = 'true';
          setTimeout(() => c.dataset.filteredOut === 'true' && (c.hidden = true), 300);
        }
      });
      empty.hidden = visible > 0;
      empty.classList.toggle('hidden', visible > 0);
    };

    tabs.forEach((t) => t.addEventListener('click', () => apply(t.dataset.filter!)));
    requestAnimationFrame(() => moveIndicator(tabs.find((t) => t.getAttribute('aria-pressed') === 'true') ?? tabs[0]));
    const onResize = () => moveIndicator(tabs.find((t) => t.getAttribute('aria-pressed') === 'true') ?? tabs[0]);
    window.addEventListener('resize', onResize);
    document.fonts?.ready.then(onResize); // al cargar la tipografía cambian los anchos de los botones
    document.addEventListener('astro:before-swap', () => window.removeEventListener('resize', onResize), { once: true });
  });
</script>
