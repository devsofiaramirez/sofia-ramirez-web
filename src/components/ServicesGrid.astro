---
import type { Service } from '@/lib/db';
import PlaceholderImage from '@/components/PlaceholderImage.astro';

interface Props {
  services: Service[];
}
const { services } = Astro.props;

const categoryMeta: Record<string, { label: string; icon: string }> = {
  consultoria: { label: 'Asesoría B2B', icon: '🤝' },
  curso: { label: 'Formación', icon: '🎓' },
  bodega: { label: 'Logística', icon: '📦' },
};
---

<section id="servicios" class="section-padding">
  <div class="container">
    <div class="max-w-2xl" data-reveal>
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.3em] text-[var(--color-gold)]">
        Portafolio
      </p>
      <h2 class="h2-display font-bold">Servicios y cursos</h2>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((service) => {
        const meta = categoryMeta[service.category] ?? { label: service.category, icon: '•' };
        return (
          <article class="card-soft flex flex-col overflow-hidden p-6" data-reveal>
            <a href={`/servicios/${service.slug}`} class="relative">
              {service.image_url ? (
                <img
                  src={service.image_url}
                  alt={service.title}
                  width="480"
                  height="360"
                  loading="lazy"
                  class="mb-5 aspect-[4/3] w-full rounded-xl object-cover"
                />
              ) : (
                <PlaceholderImage label={`Foto: ${service.title}`} aspect="4/3" class="mb-5" />
              )}
              {service.video_url && (
                <span class="absolute right-3 top-3 flex items-center gap-1 rounded-full bg-black/60 px-2.5 py-1 text-xs font-semibold text-white">
                  ▶ Video
                </span>
              )}
            </a>

            <span class="tag-pill mb-2 flex w-fit items-center gap-1.5 rounded-full px-3 py-1 text-[0.65rem] font-semibold uppercase tracking-wider">
              <span aria-hidden="true">{meta.icon}</span> {meta.label}
            </span>
            <h3 class="text-lg font-bold">
              <a href={`/servicios/${service.slug}`} class="hover:text-[var(--color-teal)]">{service.title}</a>
            </h3>
            <p class="mt-2 flex-1 text-sm text-[var(--color-text-muted)]">{service.description}</p>

            <div class="mt-5 flex flex-wrap gap-3">
              <a href={`/servicios/${service.slug}`} class="btn-ghost !py-2 !px-4 text-sm">Ver más</a>
              {service.cta_url && (
                <a href={service.cta_url} target="_blank" rel="noopener" class="btn-gold !py-2 !px-4 text-sm">
                  {service.cta_text}
                </a>
              )}
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
