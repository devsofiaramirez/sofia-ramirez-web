---
// Modal publicitario configurable desde /admin/configuracion.
// Se renderiza server-side (mismo proyecto Astro+D1, sin necesidad de fetch cross-domain);
// el script solo controla cuándo mostrarlo y precarga el media para evitar el flash/colapso visual.
// Si hay video Y foto cargados, el video gana (es el formato más llamativo para una promo).
interface Props {
  enabled: boolean;
  image?: string;
  videoUrl?: string;
  text?: string;
  buttonText?: string;
  buttonUrl?: string;
}
const { enabled, image, videoUrl, text, buttonText, buttonUrl } = Astro.props;
const hasVideo = !!videoUrl;
const shouldRender = enabled && (hasVideo || !!image);
---

{shouldRender && (
  <div
    id="promo-modal-backdrop"
    class="hidden fixed inset-0 z-[100] items-center justify-center bg-black/70 backdrop-blur-sm p-4"
  >
    <div class="glass-card relative w-full max-w-md overflow-hidden !bg-[var(--color-bg-elevated)]">
      <button
        id="promo-modal-close"
        aria-label="Cerrar"
        class="absolute top-3 right-3 z-10 flex h-8 w-8 items-center justify-center rounded-full bg-black/50 text-white hover:text-[var(--color-gold-light)]"
      >
        ✕
      </button>
      {hasVideo ? (
        <video id="promo-modal-media" src={videoUrl} class="aspect-square w-full object-cover" autoplay muted loop playsinline controls></video>
      ) : (
        <img id="promo-modal-media" src={image} alt="Promoción" width="480" height="480" class="aspect-square w-full object-cover" />
      )}
      <div class="p-6 text-center">
        {text && <p class="mb-4 text-[var(--color-text)]">{text}</p>}
        {buttonUrl && (
          <a href={buttonUrl} target="_blank" rel="noopener" class="btn-gold">
            {buttonText || 'Quiero saber más'}
          </a>
        )}
      </div>
    </div>
  </div>
)}

{shouldRender && (
  <script define:vars={{ hasVideo }} is:inline>
    const backdrop = document.getElementById('promo-modal-backdrop');
    const closeBtn = document.getElementById('promo-modal-close');
    const media = document.getElementById('promo-modal-media');

    function closeModal() {
      backdrop?.classList.add('hidden');
      backdrop?.classList.remove('flex');
    }

    if (backdrop && media && !sessionStorage.getItem('promoModalShown')) {
      const show = () => {
        backdrop.classList.remove('hidden');
        backdrop.classList.add('flex');
        sessionStorage.setItem('promoModalShown', '1');
      };
      // Precargar antes de mostrar para evitar el colapso visual mientras carga.
      const readyEvent = hasVideo ? 'loadeddata' : 'load';
      const isReady = hasVideo ? media.readyState >= 2 : media.complete;
      if (isReady) {
        setTimeout(show, 1200);
      } else {
        media.addEventListener(readyEvent, () => setTimeout(show, 300));
        media.addEventListener('error', () => {}); // si falla el media, simplemente no se muestra
      }
    }

    closeBtn?.addEventListener('click', closeModal);
    backdrop?.addEventListener('click', (e) => {
      if (e.target === backdrop) closeModal();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
    });
  </script>
)}
