---
// Acceso discreto al panel admin, fijo en la esquina inferior derecha del sitio público.
---

<a
  href="/admin/login"
  aria-label="Ingresar al panel de administración"
  title="Panel admin"
  class="fixed bottom-6 right-6 z-40 flex h-11 w-11 items-center justify-center rounded-full border border-[var(--color-border)] bg-[var(--color-bg-elevated)]/80 text-[var(--color-text-muted)] opacity-60 backdrop-blur-md transition-all hover:opacity-100 hover:border-[var(--color-gold)] hover:text-[var(--color-gold)]"
  style="padding-bottom: env(safe-area-inset-bottom);"
>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
    <rect x="5" y="11" width="14" height="9" rx="2" />
    <path d="M8 11V7a4 4 0 0 1 8 0v4" />
  </svg>
</a>
