---
import { buildWhatsappUrl, splitTitle, plainTitle } from '@/lib/utils';

interface Props {
  title: string;
  subtitle: string;
  videoUrl?: string;
  whatsappNumber: string;
  whatsappMessage: string;
  avatarUrl?: string;
  quoteEnabled?: boolean;
}
const { title, subtitle, videoUrl, whatsappNumber, whatsappMessage, avatarUrl, quoteEnabled = false } = Astro.props;
const heroAvatar = avatarUrl || '/images/hero/sofia-hero.jpg';
const whatsappUrl = buildWhatsappUrl(whatsappNumber, whatsappMessage);
const words = splitTitle(title || 'Tu aliada estratégica en importaciones y logística');

function toEmbedUrl(url: string): string | null {
  try {
    const u = new URL(url);
    if (u.hostname.includes('youtu')) {
      const id = u.hostname.includes('youtu.be') ? u.pathname.slice(1) : u.searchParams.get('v');
      return id ? `https://www.youtube.com/embed/${id}?autoplay=1` : null;
    }
    if (u.hostname.includes('vimeo')) {
      const id = u.pathname.split('/').filter(Boolean).pop();
      return id ? `https://player.vimeo.com/video/${id}?autoplay=1` : null;
    }
    return null;
  } catch {
    return null;
  }
}
const embedUrl = videoUrl ? toEmbedUrl(videoUrl) : null;

const trust = [
  { label: 'Asesoría personalizada', icon: '<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>' },
  { label: 'Bodega propia en Cúcuta', icon: '<path d="M3 21V8l9-5 9 5v13"/><path d="M7 21v-8h10v8"/>' },
  { label: 'Cursos 100 % prácticos', icon: '<path d="M2 9l10-5 10 5-10 5z"/><path d="M6 11v5c0 1.5 2.7 3 6 3s6-1.5 6-3v-5"/>' },
];
---

<section id="inicio" class="hero home-hero scope-dark relative isolate overflow-hidden pt-32 pb-20 md:pt-40 md:pb-28">
  <!-- Fondo: retícula + auroras que se mueven despacio -->
  <div class="hero-grid absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="aurora -z-10" style="width:42rem;height:42rem;top:-18rem;right:-12rem;background:#2c5282;" aria-hidden="true"></div>
  <div class="aurora -z-10" style="width:28rem;height:28rem;bottom:-14rem;left:-8rem;background:#f59e0b;opacity:.25;animation-delay:-6s" aria-hidden="true"></div>

  <div class="container grid items-center gap-14 lg:grid-cols-[1.15fr_0.85fr] lg:gap-10">
    <div>
      <p class="eyebrow" data-intro>Consultora e importadora · China ⇄ Colombia</p>

      <h1 class="h1-display font-extrabold" aria-label={plainTitle(title)}>
        {words.map((w) => (
          <><span class="split-word" aria-hidden="true"><span class={w.highlight ? 'highlight' : ''}>{w.word}</span></span>{' '}</>
        ))}
      </h1>

      <p class="mt-6 max-w-xl text-lg leading-relaxed text-[var(--color-text-muted)]" data-intro>{subtitle}</p>

      <div class="mt-10 flex flex-wrap gap-3" data-intro>
        <a href={whatsappUrl} target="_blank" rel="noopener" class="btn-accent">
          Hablar por WhatsApp
          <svg class="btn-arrow h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        {quoteEnabled ? (
          <a href="/cotizar" class="btn-ghost">Cotiza tu importación</a>
        ) : (
          <a href="/servicios" class="btn-ghost">Ver servicios</a>
        )}
        {embedUrl && (
          <button type="button" id="hero-video-trigger" class="btn-ghost group" aria-haspopup="dialog">
            <span class="flex h-6 w-6 items-center justify-center rounded-full bg-[var(--color-accent)] text-[var(--color-ink)] transition-transform group-hover:scale-110" aria-hidden="true">
              <svg class="ml-0.5 h-3 w-3" viewBox="0 0 24 24" fill="currentColor"><path d="M6 4l14 8-14 8z"/></svg>
            </span>
            Ver video
          </button>
        )}
      </div>

      <ul class="mt-12 flex flex-wrap gap-x-6 gap-y-3" data-intro>
        {trust.map((t) => (
          <li class="flex items-center gap-2 text-sm text-[var(--color-text-muted)]">
            <svg class="h-4 w-4 text-[var(--color-accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={t.icon} />
            {t.label}
          </li>
        ))}
      </ul>
    </div>

    <!-- Foto con insignias flotantes; en computador se inclina levemente siguiendo el mouse -->
    <div class="hero-visual relative mx-auto w-full max-w-[22rem] sm:max-w-sm lg:max-w-[26rem]" data-intro-visual>
      <div class="hero-tilt relative" style="transform-style: preserve-3d;">
        <div class="absolute -inset-3 rounded-[2.4rem] bg-gradient-to-br from-[var(--color-accent)]/70 via-transparent to-[#2c5282]/80 opacity-70 blur-xl" aria-hidden="true"></div>
        <div class="relative aspect-[4/5] overflow-hidden rounded-[2rem] border border-white/15 bg-[#13294a]">
          <img
            src={heroAvatar}
            alt="Sofía Ramírez, consultora e importadora"
            width="800"
            height="1000"
            fetchpriority="high"
            loading="eager"
            decoding="async"
            class="hero-photo h-full w-full object-cover object-top"
          />
          <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-[#0b1a30]/80 to-transparent" aria-hidden="true"></div>
        </div>

        <div class="float-chip absolute -left-4 top-10 flex items-center gap-2.5 rounded-2xl border border-white/15 bg-white/10 px-3.5 py-2.5 text-sm font-semibold text-white shadow-xl backdrop-blur-md sm:-left-10" data-depth="30">
          <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-[var(--color-accent)] text-[var(--color-ink)]" aria-hidden="true">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.8 19.2L16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/></svg>
          </span>
          China ⇄ Colombia
        </div>

        <div class="float-chip absolute -right-3 bottom-16 flex items-center gap-2.5 rounded-2xl bg-white px-3.5 py-2.5 text-sm font-semibold text-[#0f2440] shadow-2xl sm:-right-8" data-depth="45">
          <span class="relative flex h-2.5 w-2.5" aria-hidden="true">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
          </span>
          Bodega propia · Cúcuta
        </div>
      </div>
    </div>
  </div>

  <button type="button" data-scroll-to="como-trabajamos" class="scroll-cue absolute bottom-6 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-2 text-[0.65rem] font-semibold uppercase tracking-[0.3em] text-[var(--color-text-muted)] md:flex" aria-label="Bajar a cómo trabajamos">
    <span class="block h-8 w-px bg-gradient-to-b from-transparent to-[var(--color-accent)]"></span>
    Desliza
  </button>
</section>

{embedUrl && (
  <div id="hero-video-backdrop" class="modal-backdrop fixed inset-0 z-[100] flex items-center justify-center bg-[#0b1a30]/85 p-4 backdrop-blur-md" data-open="false" data-embed={embedUrl} role="dialog" aria-modal="true" aria-label="Video de presentación">
    <div class="modal-panel relative w-full max-w-4xl overflow-hidden rounded-2xl border border-white/10 bg-black shadow-2xl" style="aspect-ratio: 16/9;">
      <button id="hero-video-close" type="button" aria-label="Cerrar video" class="absolute right-3 top-3 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-black/60 text-white transition-transform hover:rotate-90">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
      <div id="hero-video-frame" class="h-full w-full"></div>
    </div>
  </div>
)}

<script>
  import { gsap, reducedMotion, getLenis, onPageLoad } from '@/scripts/motion';

  onPageLoad(() => {
    const hero = document.querySelector<HTMLElement>('.home-hero');
    if (!hero) return;

    // Entrada: palabras del título una por una, luego el resto; la foto se asoma con un leve zoom.
    // A partir de aquí manda GSAP (quita el estado oculto del CSS en el mismo cuadro).
    hero.classList.add('is-ready');
    if (!reducedMotion()) {
      const tl = gsap.timeline({ defaults: { ease: 'expo.out' } });
      tl.from(hero.querySelectorAll('.split-word > span'), { yPercent: 110, duration: 1.1, stagger: 0.06 })
        .from(hero.querySelectorAll('[data-intro]'), { y: 24, opacity: 0, duration: 1, stagger: 0.1, clearProps: 'all' }, '-=0.8')
        .from(hero.querySelector('[data-intro-visual]'), { y: 40, rotate: 2, duration: 1.4, clearProps: 'transform' }, 0.1)
        .from(hero.querySelector('.hero-photo'), { scale: 1.18, duration: 1.8, clearProps: 'transform' }, 0.1)
        .from(hero.querySelectorAll('.float-chip'), { scale: 0.6, opacity: 0, duration: 0.9, stagger: 0.15, ease: 'back.out(1.8)', clearProps: 'transform,opacity' }, 0.7);

      // Al bajar, la foto sube un poco más lento que el texto (profundidad).
      gsap.to(hero.querySelector('.hero-visual'), {
        yPercent: -12,
        ease: 'none',
        scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: true },
      });

      // En computador, la foto y las insignias se inclinan siguiendo el mouse.
      const tilt = hero.querySelector<HTMLElement>('.hero-tilt');
      if (tilt && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        const rx = gsap.quickTo(tilt, 'rotationX', { duration: 0.8, ease: 'power3.out' });
        const ry = gsap.quickTo(tilt, 'rotationY', { duration: 0.8, ease: 'power3.out' });
        gsap.set(tilt, { transformPerspective: 900 });
        const chips = [...hero.querySelectorAll<HTMLElement>('[data-depth]')].map((el) => ({
          x: gsap.quickTo(el, 'x', { duration: 1, ease: 'power3.out' }),
          y: gsap.quickTo(el, 'y', { duration: 1, ease: 'power3.out' }),
          depth: Number(el.dataset.depth),
        }));
        hero.addEventListener('pointermove', (e) => {
          const nx = e.clientX / window.innerWidth - 0.5;
          const ny = e.clientY / window.innerHeight - 0.5;
          rx(ny * -8);
          ry(nx * 10);
          chips.forEach((c) => {
            c.x(nx * c.depth);
            c.y(ny * c.depth);
          });
        });
        hero.addEventListener('pointerleave', () => {
          rx(0);
          ry(0);
          chips.forEach((c) => {
            c.x(0);
            c.y(0);
          });
        });
      }
    }

    // Video de presentación: se abre con animación y el iframe se crea solo al abrir (no pesa en la carga).
    const backdrop = document.getElementById('hero-video-backdrop');
    const trigger = document.getElementById('hero-video-trigger');
    const frame = document.getElementById('hero-video-frame');
    if (!backdrop || !trigger || !frame) return;
    const open = () => {
      frame.innerHTML = `<iframe src="${backdrop.dataset.embed}" title="Video de presentación" class="h-full w-full" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>`;
      backdrop.dataset.open = 'true';
      getLenis()?.stop();
      document.getElementById('hero-video-close')?.focus();
    };
    const close = () => {
      if (backdrop.dataset.open !== 'true') return;
      backdrop.dataset.open = 'false';
      getLenis()?.start();
      setTimeout(() => (frame.innerHTML = ''), 400);
      trigger.focus();
    };
    trigger.addEventListener('click', open);
    document.getElementById('hero-video-close')?.addEventListener('click', close);
    backdrop.addEventListener('click', (e) => e.target === backdrop && close());
    backdrop.addEventListener('keydown', (e) => e.key === 'Escape' && close());
  });
</script>
