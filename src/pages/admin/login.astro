---
export const prerender = false;
import '@/styles/global.css';
import BrandLogo from '@/components/BrandLogo.astro';

if (Astro.locals.user) return Astro.redirect('/admin');

const error = Astro.url.searchParams.get('error');
const errorMessages: Record<string, string> = {
  required: 'Completa correo y contraseña.',
  invalid: 'Correo o contraseña incorrectos.',
  server: 'Error de configuración del servidor.',
};
---

<!doctype html>
<html lang="es" class="theme-dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Iniciar sesión | Panel admin — Sofía Ramírez</title>
  </head>
  <body class="flex min-h-screen items-center justify-center bg-[var(--color-bg)] p-6 text-[var(--color-text)]">
    <div class="glass-card w-full max-w-sm p-8">
      <div class="mb-8 flex justify-center">
        <BrandLogo variant="full" />
      </div>

      {error && (
        <p class="mb-4 rounded-lg bg-red-500/10 px-4 py-2 text-sm text-red-400">
          {errorMessages[error] ?? 'Ocurrió un error.'}
        </p>
      )}

      <form method="POST" action="/api/auth/login" class="space-y-4">
        <div>
          <label class="mb-1 block text-sm font-semibold" for="email">Correo</label>
          <input
            id="email" name="email" type="email" required autocomplete="email"
            class="w-full rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-elevated)] px-4 py-2.5 text-sm outline-none focus:border-[var(--color-gold)]"
          />
        </div>
        <div>
          <label class="mb-1 block text-sm font-semibold" for="password">Contraseña</label>
          <input
            id="password" name="password" type="password" required autocomplete="current-password"
            class="w-full rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-elevated)] px-4 py-2.5 text-sm outline-none focus:border-[var(--color-gold)]"
          />
        </div>
        <button type="submit" class="btn-gold w-full">Iniciar sesión</button>
      </form>
    </div>
  </body>
</html>
