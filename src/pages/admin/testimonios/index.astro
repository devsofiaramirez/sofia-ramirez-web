---
export const prerender = false;
import AdminLayout from '@/layouts/AdminLayout.astro';
import { getAllTestimonials, updateTestimonial, deleteTestimonial, reorderTestimonials } from '@/lib/db';
import { swapNeighbor } from '@/lib/utils';

if (!Astro.locals.user) return Astro.redirect('/admin/login');

const db = Astro.locals.runtime.env.DB;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('action')?.toString();
  const id = Number(form.get('id'));

  if (action === 'toggle') {
    const all = await getAllTestimonials(db);
    const t = all.find((x) => x.id === id);
    if (t) await updateTestimonial(db, id, { is_active: t.is_active ? 0 : 1 });
  }
  if (action === 'delete') {
    await deleteTestimonial(db, id);
  }
  if (action === 'move-up' || action === 'move-down') {
    const all = await getAllTestimonials(db);
    const ids = all.map((x) => x.id);
    const reordered = swapNeighbor(ids, id, action === 'move-up' ? -1 : 1);
    await reorderTestimonials(db, reordered);
  }
  return Astro.redirect('/admin/testimonios');
}

const testimonials = await getAllTestimonials(db);
---

<AdminLayout title="Testimonios">
  <div class="mb-2 flex items-center justify-between">
    <h1 class="text-2xl font-bold">Testimonios</h1>
    <a href="/admin/testimonios/nuevo" class="btn-gold !py-2 !px-4 text-sm">+ Nuevo</a>
  </div>
  <p class="mb-6 text-sm text-[var(--color-text-muted)]">
    Estos son los casos de éxito que la gente ve antes de escribirte. Entre más reales y específicos, más confianza generan.
  </p>

  <div class="glass-card overflow-hidden !p-0">
    {testimonials.map((t, i) => (
      <div class="flex flex-wrap items-center gap-4 border-b border-[var(--color-border)] p-4 last:border-b-0">
        {t.photo_url && <img src={t.photo_url} class="h-10 w-10 rounded-full object-cover" alt="" />}
        <div class="min-w-[10rem] flex-1">
          <p class="font-semibold">{t.author_name}</p>
          <p class="text-xs text-[var(--color-text-muted)]">{t.author_role}</p>
        </div>

        <span class={`rounded px-2 py-1 text-xs font-bold ${t.is_active ? 'bg-[var(--color-gold)]/15 text-[var(--color-gold)]' : 'bg-black/5 text-[var(--color-text-muted)]'}`}>
          {t.is_active ? 'Activo' : 'Oculto'}
        </span>

        <div class="flex items-center gap-1">
          <form method="POST">
            <input type="hidden" name="action" value="move-up" />
            <input type="hidden" name="id" value={t.id} />
            <button type="submit" disabled={i === 0} class="rounded p-1.5 text-[var(--color-text-muted)] hover:text-[var(--color-gold)] disabled:opacity-30">▲</button>
          </form>
          <form method="POST">
            <input type="hidden" name="action" value="move-down" />
            <input type="hidden" name="id" value={t.id} />
            <button type="submit" disabled={i === testimonials.length - 1} class="rounded p-1.5 text-[var(--color-text-muted)] hover:text-[var(--color-gold)] disabled:opacity-30">▼</button>
          </form>
        </div>

        <form method="POST">
          <input type="hidden" name="action" value="toggle" />
          <input type="hidden" name="id" value={t.id} />
          <button type="submit" class="text-sm text-[var(--color-gold)] hover:underline">{t.is_active ? 'Ocultar' : 'Activar'}</button>
        </form>

        <a href={`/admin/testimonios/${t.id}`} class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-gold)]">Editar</a>

        <form method="POST" onsubmit="return confirm('¿Eliminar este testimonio?')">
          <input type="hidden" name="action" value="delete" />
          <input type="hidden" name="id" value={t.id} />
          <button type="submit" class="text-sm text-red-600 hover:text-red-700">Eliminar</button>
        </form>
      </div>
    ))}
    {testimonials.length === 0 && (
      <p class="p-10 text-center text-[var(--color-text-muted)]">
        Aún no has agregado testimonios — pulsa "+ Nuevo" arriba para sumar el primer caso de éxito.
      </p>
    )}
  </div>
</AdminLayout>
