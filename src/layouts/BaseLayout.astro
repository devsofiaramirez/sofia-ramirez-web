---
import SEO from '@/components/SEO.astro';
import BrandLogo from '@/components/BrandLogo.astro';
import PromoModal from '@/components/PromoModal.astro';
import AdminAccessLink from '@/components/AdminAccessLink.astro';
import '@/styles/global.css';
import { buildWhatsappUrl } from '@/lib/utils';

interface Props {
  title: string;
  description: string;
  image?: string;
  settings: Record<string, string>;
}

const { title, description, image, settings } = Astro.props;

const whatsappUrl = buildWhatsappUrl(
  settings.whatsapp_number ?? '573000000000',
  settings.whatsapp_message ?? 'Hola Sofía, quiero más información.'
);

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Sofía Ramírez — Importaciones & Consultoría',
  url: Astro.site?.toString(),
  sameAs: [settings.social_instagram, settings.social_facebook, settings.social_tiktok, settings.social_linkedin].filter(Boolean),
};

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Sofía Ramírez',
  url: Astro.site?.toString(),
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />

    <!-- Fuentes: preload + swap para no bloquear el render (SEO 1.11 / lección #6) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      id="font-preload"
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@600;700;800&family=Inter:wght@400;500;600&display=swap"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Manrope:wght@600;700;800&family=Inter:wght@400;500;600&display=swap"
      />
    </noscript>
    <script is:inline>
      const fontLink = document.getElementById('font-preload');
      if (fontLink) {
        fontLink.onload = function () {
          fontLink.onload = null;
          fontLink.rel = 'stylesheet';
        };
      }
    </script>

    <SEO title={title} description={description} image={image} jsonLd={[orgJsonLd, websiteJsonLd]} />
  </head>
  <body>
    <header class="fixed top-0 inset-x-0 z-50 border-b border-[var(--color-border)] bg-[color-mix(in_srgb,var(--color-bg)_85%,transparent)] backdrop-blur-md" style="padding-top: env(safe-area-inset-top);">
      <div class="container flex items-center justify-between py-4">
        <a href="/" aria-label="Inicio">
          <BrandLogo variant="compact" />
        </a>

        <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-[var(--color-text-muted)]">
          <a href="/#servicios" class="hover:text-[var(--color-teal)] transition-colors">Servicios</a>
          <a href="/#cursos" class="hover:text-[var(--color-teal)] transition-colors">Cursos</a>
          <a href="/#testimonios" class="hover:text-[var(--color-teal)] transition-colors">Testimonios</a>
          <a href={whatsappUrl} target="_blank" rel="noopener" class="btn-gold !py-2.5 !px-5 text-sm">Escríbenos</a>
        </nav>

        <button
          id="mobile-menu-btn"
          class="md:hidden flex flex-col gap-1.5 p-2 z-50"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <span class="block h-0.5 w-6 bg-[var(--color-text)]"></span>
          <span class="block h-0.5 w-6 bg-[var(--color-text)]"></span>
          <span class="block h-0.5 w-6 bg-[var(--color-text)]"></span>
        </button>
      </div>

      <nav
        id="mobile-menu"
        class="md:hidden hidden flex-col gap-6 px-6 py-8 text-lg font-medium border-t border-[var(--color-border)] bg-[var(--color-bg)] max-h-[calc(100dvh-72px)] overflow-y-auto"
      >
        <a href="/#servicios" class="text-[var(--color-text-muted)] hover:text-[var(--color-teal)]">Servicios</a>
        <a href="/#cursos" class="text-[var(--color-text-muted)] hover:text-[var(--color-teal)]">Cursos</a>
        <a href="/#testimonios" class="text-[var(--color-text-muted)] hover:text-[var(--color-teal)]">Testimonios</a>
        <a href={whatsappUrl} target="_blank" rel="noopener" class="btn-gold w-fit">Escríbenos por WhatsApp</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer-scope section-padding border-t border-[var(--color-border)]" style="padding-bottom: max(var(--space-xl), env(safe-area-inset-bottom));">
      <div class="container grid gap-10 md:grid-cols-3">
        <div>
          <BrandLogo variant="full" />
          <p class="mt-4 text-sm text-[var(--color-text-muted)] max-w-xs">
            Asesoría, formación y logística de importaciones desde China hasta Cúcuta.
          </p>
        </div>

        <div class="text-sm text-[var(--color-text-muted)]">
          <p class="text-[var(--color-text)] font-semibold mb-3">Contacto</p>
          <p><a href={whatsappUrl} target="_blank" rel="noopener" class="hover:text-[var(--color-teal)]">WhatsApp</a></p>
          {settings.contact_email && <p><a href={`mailto:${settings.contact_email}`} class="hover:text-[var(--color-teal)]">{settings.contact_email}</a></p>}
        </div>

        <div class="text-sm text-[var(--color-text-muted)]">
          <p class="text-[var(--color-text)] font-semibold mb-3">Redes</p>
          <ul class="space-y-2">
            {settings.social_instagram && <li><a href={settings.social_instagram} target="_blank" rel="noopener" class="hover:text-[var(--color-teal)]">Instagram</a></li>}
            {settings.social_facebook && <li><a href={settings.social_facebook} target="_blank" rel="noopener" class="hover:text-[var(--color-teal)]">Facebook</a></li>}
            {settings.social_tiktok && <li><a href={settings.social_tiktok} target="_blank" rel="noopener" class="hover:text-[var(--color-teal)]">TikTok</a></li>}
            {settings.social_linkedin && <li><a href={settings.social_linkedin} target="_blank" rel="noopener" class="hover:text-[var(--color-teal)]">LinkedIn</a></li>}
          </ul>
        </div>
      </div>

      <div class="container mt-10 pt-6 border-t border-[var(--color-border)] text-xs text-[var(--color-text-muted)]">
        © {new Date().getFullYear()} Sofía Ramírez. Todos los derechos reservados.
      </div>
    </footer>

    <PromoModal
      enabled={settings.promo_modal_enabled === '1'}
      image={settings.promo_modal_image}
      text={settings.promo_modal_text}
      buttonText={settings.promo_modal_button_text}
      buttonUrl={settings.promo_modal_button_url}
    />

    <AdminAccessLink />

    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      btn?.addEventListener('click', () => {
        const isOpen = menu?.classList.toggle('hidden') === false;
        menu?.classList.toggle('flex', isOpen);
        btn.setAttribute('aria-expanded', String(isOpen));
      });

      // Animación de entrada al hacer scroll: un solo observer para todo [data-reveal].
      const revealEls = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15 }
      );
      revealEls.forEach((el) => {
        el.classList.add('reveal');
        observer.observe(el);
      });
    </script>
  </body>
</html>
