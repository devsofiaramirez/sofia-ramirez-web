---
import BrandLogo from '@/components/BrandLogo.astro';
import '@/styles/global.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
const path = Astro.url.pathname;

const links = [
  { href: '/admin', label: 'Dashboard' },
  { href: '/admin/configuracion', label: 'Configuración' },
  { href: '/admin/servicios', label: 'Servicios y cursos' },
  { href: '/admin/testimonios', label: 'Testimonios' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | Panel admin — Sofía Ramírez</title>
  </head>
  <body class="min-h-screen bg-[var(--color-bg)] text-[var(--color-text)] md:flex">
    <aside class="border-b md:border-b-0 md:border-r border-[var(--color-border)] md:min-h-screen md:w-64 md:flex-shrink-0">
      <div class="p-6">
        <BrandLogo variant="compact" />
      </div>
      <nav class="flex flex-col gap-1 px-4 pb-6 text-sm">
        {links.map((link) => (
          <a
            href={link.href}
            class={`rounded-lg px-4 py-2.5 transition-colors ${
              path === link.href
                ? 'bg-[var(--color-gold)]/10 text-[var(--color-gold)] font-semibold'
                : 'text-[var(--color-text-muted)] hover:bg-[var(--color-bg-elevated)]'
            }`}
          >
            {link.label}
          </a>
        ))}
        <a href="/api/auth/logout" class="mt-4 rounded-lg px-4 py-2.5 text-[var(--color-text-muted)] hover:bg-[var(--color-bg-elevated)]">
          Cerrar sesión
        </a>
      </nav>
    </aside>

    <main class="flex-1 p-6 md:p-10">
      <slot />
    </main>
  </body>
</html>
